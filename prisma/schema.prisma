// AI Visibility / GEO & SEO platform — core data model.
//
// Development uses SQLite. For production switch `provider` to "postgresql"
// and point DATABASE_URL to Postgres; the model only uses portable types
// (enum-like values are stored as String and validated in src/lib/constants.ts).
// Json columns are nullable: Prisma 6 cannot emit Json defaults for SQLite, so
// readers treat null as {} / [].

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A tracked website (a "project" in the UI).
model Site {
  id             String   @id @default(cuid())
  url            String   @unique // normalized origin, e.g. https://example.com
  title          String
  description    String?
  /// Free-form settings: crawl depth, rate limits, locale, etc.
  settings       Json?     
  /// Target keywords / prompts the site wants to rank for in AI answers.
  targetKeywords Json?     
  /// Platform integration keys (IndexNow, GSC, ...). Never returned unmasked by the API.
  integrations   Json?     
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  crawlSessions    CrawlSession[]
  pages            CrawledPage[]
  entities         GraphEntity[]
  relations        GraphRelation[]
  audits           GeoAudit[]
  visibilityChecks LlmVisibilityRecord[]
  actionItems      ActionItem[]
  scheduledReports ScheduledReport[]
  reportRuns       ReportRun[]
  submissions      PlatformSubmission[]
  submissionQueue  SubmissionQueueItem[]
  autoGeoSuggestions AutoGeoSuggestion[]
  competitorAnalyses CompetitorAnalysis[]
  entityEnrichments  EntityEnrichment[]
  botSimulations     BotSimulationRecord[]
  syntheticQueries   SyntheticQuery[]
}

/// One crawl run over a site. status: queued | running | completed | failed | cancelled
model CrawlSession {
  id           String    @id @default(cuid())
  siteId       String
  status       String    @default("queued")
  trigger      String    @default("manual") // manual | scheduled | api
  maxPages     Int       @default(500)
  maxDepth     Int       @default(5)
  pagesCrawled Int       @default(0)
  pagesFailed  Int       @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pages    CrawledPage[]
  audits   GeoAudit[]
  entities GraphEntity[]

  @@index([siteId, createdAt])
}

/// Raw technical SEO facts for a crawled URL (latest snapshot per site+url).
model CrawledPage {
  id             String   @id @default(cuid())
  siteId         String
  crawlSessionId String?
  url            String
  statusCode     Int?
  pageType       String? // home | product | category | article | about | contact | faq | other
  title          String?
  metaDescription String?
  canonical      String?
  h1             String?
  wordCount      Int      @default(0)
  depth          Int      @default(0)
  /// Extracted structured data / headings / OpenGraph etc.
  data           Json?     
  crawledAt      DateTime @default(now())

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlSession CrawlSession? @relation(fields: [crawlSessionId], references: [id], onDelete: SetNull)

  @@unique([siteId, url])
}

/// Knowledge-graph node. entityType: Page | Product | Category | FAQ | Organization | Author | Person | Brand | Concept | Article | WikidataEntity
/// Reconciled entities carry properties.wikidataId / wikipediaUrl / sameAs[] / confidence / reconciliation (see services/wikidata.ts).
model GraphEntity {
  id             String   @id @default(cuid())
  siteId         String
  crawlSessionId String?
  /// Stable key inside a site (e.g. canonical URL or "product:sku-123") — used for idempotent upserts.
  key            String
  entityType     String
  name           String
  url            String?
  properties     Json?     
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlSession CrawlSession? @relation(fields: [crawlSessionId], references: [id], onDelete: SetNull)
  outgoing     GraphRelation[] @relation("RelationSource")
  incoming     GraphRelation[] @relation("RelationTarget")
  enrichment   EntityEnrichment?

  @@unique([siteId, key])
  @@index([siteId, entityType])
}

/// Knowledge-graph edge. relationType: links_to | has_category | contains_product | written_by | mentions_entity | answers_question | same_as | part_of
model GraphRelation {
  id           String   @id @default(cuid())
  siteId       String
  sourceId     String
  targetId     String
  relationType String
  weight       Float    @default(1)
  properties   Json?     
  createdAt    DateTime @default(now())

  site   Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source GraphEntity @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target GraphEntity @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([siteId])
}

/// Score snapshot of an audit run. All scores 0-100. status: pending | running | completed | failed
model GeoAudit {
  id             String    @id @default(cuid())
  siteId         String
  crawlSessionId String?
  status         String    @default("pending")
  geoScore       Int?
  seoScore       Int?
  eeatScore      Int?
  /// Sub-metrics, e.g. { schemaCoverage: 72, crawlerAccess: 100, contentDepth: 55, ... }
  metrics        Json?      
  summary        String?
  error          String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlSession CrawlSession? @relation(fields: [crawlSessionId], references: [id], onDelete: SetNull)
  actionItems  ActionItem[]

  @@index([siteId, createdAt])
}

/// Result of asking an LLM a query and checking if the site appears.
/// model: chatgpt | gemini | claude | perplexity | ... ; citationStatus: cited | mentioned | none
model LlmVisibilityRecord {
  id             String   @id @default(cuid())
  siteId         String
  model          String
  query          String
  citationStatus String
  position       Int?
  excerpt        String?
  responseMeta   Json?     
  checkedAt      DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, model, checkedAt])
}

/// Recommended improvement. category: crawler | schema | content | authority | technical
/// impact / effort: high | medium | low ; status: open | in_progress | resolved | dismissed
model ActionItem {
  id          String    @id @default(cuid())
  siteId      String
  auditId     String?
  title       String
  description String?
  category    String
  impact      String
  effort      String?
  /// Scoring rule that produced the item (e.g. "schema.faq_page"); null for manually created items.
  /// (ruleId, targetUrl) identifies the same recommendation across audits.
  ruleId      String?
  /// Higher = do first (impact x reach / effort, blockers boosted).
  priority    Float?
  /// { check_id, evidence[], expected_gain, affected_urls[], affected_count, snippet { language, code, filename, instructions } }
  details     Json?
  status      String    @default("open")
  /// Optional URL / entity this recommendation targets.
  targetUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  site  Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  audit GeoAudit? @relation(fields: [auditId], references: [id], onDelete: SetNull)

  @@index([siteId, status])
  @@index([siteId, ruleId])
}

/// Recurring report delivery. frequency: daily | weekly
model ScheduledReport {
  id         String    @id @default(cuid())
  siteId     String
  frequency  String
  recipients Json?
  webhookUrl String?
  /// Durable, non-expiring claim. Interrupted runs require explicit operator recovery.
  claimId    String?
  claimedAt  DateTime?
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
}

/// Immutable report evidence and delivery outcomes. status: running | completed | partial | failed | interrupted
model ReportRun {
  id         String   @id @default(cuid())
  siteId     String
  scheduleId String
  frequency  String
  status     String   @default("running")
  auditId    String?
  crawlSessionId String?
  snapshot   Json?
  steps      Json?
  deliveries Json?
  createdAt  DateTime @default(now())
  finishedAt DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([scheduleId, status])
}

/// Log of content/URL pushes to external platforms (IndexNow, AI platforms).
/// status: queued | sent | failed
model PlatformSubmission {
  id         String   @id @default(cuid())
  siteId     String
  platform   String
  urls       Json?     
  payload    Json?     
  status     String   @default("queued")
  response   Json?     
  createdAt  DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

/// Outbound URL notification queue: one row per site + url + channel, the latest change wins.
/// channel: indexnow | google_indexing ; reason: created | updated | deleted
/// status: pending | processing | sent | failed | skipped
model SubmissionQueueItem {
  id            String    @id @default(cuid())
  siteId        String
  url           String
  channel       String
  reason        String    @default("updated")
  status        String    @default("pending")
  /// Fingerprint of the page content at enqueue time; change detection compares against it.
  contentHash   String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  /// Set while a dispatcher owns the row, so concurrent runs never send it twice.
  claimId       String?
  lastError     String?
  submissionId  String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url, channel])
  @@index([status, nextAttemptAt])
  @@index([siteId, status])
}

// ---- GEO Stage 2 (GENE-109): persisted AutoGEO / competitor / entity / bot / query data ----

/// One block-level AutoGEO rewrite or insertion for a page (see services/autogeo-suggestions.ts).
/// ruleType: stats | quotes | citations | answer_capsule | tone | keyword_stuffing | comparison_table
/// status: pending | applied | dismissed
model AutoGeoSuggestion {
  id               String   @id @default(cuid())
  siteId           String
  pageUrl          String
  ruleType         String
  /// Engine rule that produced the suggestion, e.g. "autogeo.statistics".
  ruleId           String?
  title            String?
  originalSnippet  String
  suggestedSnippet String
  /// Unified diff (Markdown) from originalSnippet to suggestedSnippet.
  diffMarkdown     String?
  /// Expected visibility gain in percent (GEO paper estimates).
  expectedGain     Float    @default(0)
  status           String   @default("pending")
  /// Stable hash of page + rule + snippets: re-running an analysis never duplicates a suggestion.
  fingerprint      String
  actionItemId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, fingerprint])
  @@index([siteId, status])
  @@index([siteId, pageUrl])
}

/// Latest Share-of-Model snapshot per configured competitor (recomputed from LlmVisibilityRecord).
model CompetitorAnalysis {
  id                String   @id @default(cuid())
  siteId            String
  competitorDomain  String
  competitorName    String?
  /// Citation share among the site + configured competitors, 0-100.
  shareOfModel      Float    @default(0)
  mentionShare      Float?
  citedQueriesCount Int      @default(0)
  /// Queries where this competitor is cited and the site is not.
  gapQueriesCount   Int      @default(0)
  /// [{ url, count }] most cited competitor URLs.
  topCitedUrls      Json?
  /// Mean lexicon sentiment -1..1; null when no brand clause was found.
  sentimentScore    Float?
  samples           Int      @default(0)
  windowDays        Int      @default(30)
  lastCheckedAt     DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, competitorDomain])
}

/// Wikidata enrichment of a knowledge-graph entity (mirror of GraphEntity.properties reconciliation).
model EntityEnrichment {
  id              String   @id @default(cuid())
  siteId          String
  entityId        String?  @unique
  entityKey       String
  entityName      String
  entityType      String
  /// pending | matched | declared | review | unmatched | error | verified | rejected
  status          String   @default("pending")
  wikidataId      String?
  wikipediaUrl    String?
  sameAsLinks     Json?
  matchConfidence Float    @default(0)
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  site   Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  entity GraphEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@unique([siteId, entityKey])
  @@index([siteId, isVerified])
}

/// One live fetch of a site URL with an AI crawler identity.
/// botName: GPTBot | ClaudeBot | PerplexityBot | Google-Extended | Applebot-Extended | ...
model BotSimulationRecord {
  id          String   @id @default(cuid())
  siteId      String
  /// Groups the records of one simulation request.
  runId       String
  url         String
  botName     String
  statusCode  Int?
  isBlocked   Boolean  @default(false)
  /// cloudflare | imperva | akamai | aws_waf | sucuri | http_status | robots | network | null
  blockedBy   String?
  isCsrShell  Boolean  @default(false)
  /// Approximate LLM tokens of the visible text (chars / 4).
  tokenCount  Int      @default(0)
  bytes       Int      @default(0)
  loadTimeMs  Int      @default(0)
  headers     Json?
  /// { textChars, scriptBytes, shellSelector, reasons[], error }
  diagnostics Json?
  checkedAt   DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, checkedAt])
  @@index([siteId, runId])
}

/// GEO-bench style test prompt. intent: informational | comparative | transactional | reputation
/// source: template | manual | llm ; status: active | archived
model SyntheticQuery {
  id          String   @id @default(cuid())
  siteId      String
  query       String
  intent      String
  /// Prompt language: tr | en. The column default "tr" is historical and kept for compatibility; the API always writes the language explicitly.
  language    String   @default("tr")
  entityKey   String?
  entityName  String?
  /// 0-100 heuristic competitiveness of the prompt.
  difficulty  Int      @default(50)
  source      String   @default("template")
  status      String   @default("active")
  /// Normalized text: case/diacritics-insensitive duplicate guard.
  fingerprint String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, fingerprint])
  @@index([siteId, intent, status])
}

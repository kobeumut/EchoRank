// AI Visibility / GEO & SEO platform — core data model.
//
// Development uses SQLite. For production switch `provider` to "postgresql"
// and point DATABASE_URL to Postgres; the model only uses portable types
// (enum-like values are stored as String and validated in src/lib/constants.ts).
// Json columns are nullable: Prisma 6 cannot emit Json defaults for SQLite, so
// readers treat null as {} / [].

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A tracked website (a "project" in the UI).
model Site {
  id             String   @id @default(cuid())
  url            String   @unique // normalized origin, e.g. https://example.com
  title          String
  description    String?
  /// Free-form settings: crawl depth, rate limits, locale, etc.
  settings       Json?     
  /// Target keywords / prompts the site wants to rank for in AI answers.
  targetKeywords Json?     
  /// Platform integration keys (IndexNow, GSC, ...). Never returned unmasked by the API.
  integrations   Json?     
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  crawlSessions    CrawlSession[]
  pages            CrawledPage[]
  entities         GraphEntity[]
  relations        GraphRelation[]
  audits           GeoAudit[]
  visibilityChecks LlmVisibilityRecord[]
  actionItems      ActionItem[]
  scheduledReports ScheduledReport[]
  submissions      PlatformSubmission[]
  submissionQueue  SubmissionQueueItem[]
  snapshots        MetricSnapshot[]
  reportDeliveries ReportDelivery[]
}

/// One crawl run over a site. status: queued | running | completed | failed | cancelled
model CrawlSession {
  id           String    @id @default(cuid())
  siteId       String
  status       String    @default("queued")
  trigger      String    @default("manual") // manual | scheduled | api
  maxPages     Int       @default(500)
  maxDepth     Int       @default(5)
  pagesCrawled Int       @default(0)
  pagesFailed  Int       @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pages    CrawledPage[]
  audits   GeoAudit[]
  entities GraphEntity[]

  @@index([siteId, createdAt])
}

/// Raw technical SEO facts for a crawled URL (latest snapshot per site+url).
model CrawledPage {
  id             String   @id @default(cuid())
  siteId         String
  crawlSessionId String?
  url            String
  statusCode     Int?
  pageType       String? // home | product | category | article | about | contact | faq | other
  title          String?
  metaDescription String?
  canonical      String?
  h1             String?
  wordCount      Int      @default(0)
  depth          Int      @default(0)
  /// Extracted structured data / headings / OpenGraph etc.
  data           Json?     
  crawledAt      DateTime @default(now())

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlSession CrawlSession? @relation(fields: [crawlSessionId], references: [id], onDelete: SetNull)

  @@unique([siteId, url])
}

/// Knowledge-graph node. entityType: Page | Product | Category | FAQ | Organization | Author | Brand | Concept | Article
model GraphEntity {
  id             String   @id @default(cuid())
  siteId         String
  crawlSessionId String?
  /// Stable key inside a site (e.g. canonical URL or "product:sku-123") — used for idempotent upserts.
  key            String
  entityType     String
  name           String
  url            String?
  properties     Json?     
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlSession CrawlSession? @relation(fields: [crawlSessionId], references: [id], onDelete: SetNull)
  outgoing     GraphRelation[] @relation("RelationSource")
  incoming     GraphRelation[] @relation("RelationTarget")

  @@unique([siteId, key])
  @@index([siteId, entityType])
}

/// Knowledge-graph edge. relationType: links_to | has_category | contains_product | written_by | mentions_entity | answers_question | same_as | part_of
model GraphRelation {
  id           String   @id @default(cuid())
  siteId       String
  sourceId     String
  targetId     String
  relationType String
  weight       Float    @default(1)
  properties   Json?     
  createdAt    DateTime @default(now())

  site   Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source GraphEntity @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target GraphEntity @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([siteId])
}

/// Score snapshot of an audit run. All scores 0-100. status: pending | running | completed | failed
model GeoAudit {
  id             String    @id @default(cuid())
  siteId         String
  crawlSessionId String?
  status         String    @default("pending")
  geoScore       Int?
  seoScore       Int?
  eeatScore      Int?
  /// Sub-metrics, e.g. { schemaCoverage: 72, crawlerAccess: 100, contentDepth: 55, ... }
  metrics        Json?      
  summary        String?
  error          String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlSession CrawlSession? @relation(fields: [crawlSessionId], references: [id], onDelete: SetNull)
  actionItems  ActionItem[]

  @@index([siteId, createdAt])
}

/// Result of asking an LLM a query and checking if the site appears.
/// model: chatgpt | gemini | claude | perplexity | ... ; citationStatus: cited | mentioned | none
model LlmVisibilityRecord {
  id             String   @id @default(cuid())
  siteId         String
  model          String
  query          String
  citationStatus String
  position       Int?
  excerpt        String?
  responseMeta   Json?     
  checkedAt      DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, model, checkedAt])
}

/// Recommended improvement. category: crawler | schema | content | authority | technical
/// impact / effort: high | medium | low ; status: open | in_progress | resolved | dismissed
model ActionItem {
  id          String    @id @default(cuid())
  siteId      String
  auditId     String?
  title       String
  description String?
  category    String
  impact      String
  effort      String?
  /// Scoring rule that produced the item (e.g. "schema.faq_page"); null for manually created items.
  /// (ruleId, targetUrl) identifies the same recommendation across audits.
  ruleId      String?
  /// Higher = do first (impact x reach / effort, blockers boosted).
  priority    Float?
  /// { check_id, evidence[], expected_gain, affected_urls[], affected_count, snippet { language, code, filename, instructions } }
  details     Json?
  status      String    @default("open")
  /// Optional URL / entity this recommendation targets.
  targetUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  site  Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  audit GeoAudit? @relation(fields: [auditId], references: [id], onDelete: SetNull)

  @@index([siteId, status])
  @@index([siteId, ruleId])
}

/// Recurring report delivery. frequency: daily | weekly
model ScheduledReport {
  id         String    @id @default(cuid())
  siteId     String
  frequency  String
  /// E-mail addresses (string[]).
  recipients Json?
  /// Webhook targets: [{ url, type: slack | discord | generic }]
  webhooks   Json?
  /// Also push immediate alerts to these channels when an anomaly is detected.
  alerts     Boolean   @default(true)
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  /// Outcome of the last run: sent | partial | failed | simulated
  lastStatus String?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  site       Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deliveries ReportDelivery[]

  @@index([enabled, nextRunAt])
}

/// Log of content/URL pushes to external platforms (IndexNow, AI platforms).
/// status: queued | sent | failed
model PlatformSubmission {
  id         String   @id @default(cuid())
  siteId     String
  platform   String
  urls       Json?     
  payload    Json?     
  status     String   @default("queued")
  response   Json?     
  createdAt  DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

/// Outbound URL notification queue: one row per site + url + channel, the latest change wins.
/// channel: indexnow | google_indexing ; reason: created | updated | deleted
/// status: pending | processing | sent | failed | skipped
model SubmissionQueueItem {
  id            String    @id @default(cuid())
  siteId        String
  url           String
  channel       String
  reason        String    @default("updated")
  status        String    @default("pending")
  /// Fingerprint of the page content at enqueue time; change detection compares against it.
  contentHash   String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  /// Set while a dispatcher owns the row, so concurrent runs never send it twice.
  claimId       String?
  lastError     String?
  submissionId  String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url, channel])
  @@index([status, nextAttemptAt])
  @@index([siteId, status])
}

/// Time-series point of a site's visibility state (GENE-99). kind: daily | weekly | manual
/// Visibility figures cover the `windowDays` before `capturedAt`; scores come from the latest completed audit.
model MetricSnapshot {
  id              String    @id @default(cuid())
  siteId          String
  kind            String
  windowDays      Int
  auditId         String?
  geoScore        Int?
  seoScore        Int?
  /// E-E-A-T = information trustworthiness score.
  eeatScore       Int?
  /// % of LLM answers that cite or mention the site (null when no checks ran in the window).
  visibilityRate  Int?
  /// % of LLM answers that cite the site.
  citationRate    Int?
  citedCount      Int       @default(0)
  mentionedCount  Int       @default(0)
  totalChecks     Int       @default(0)
  openActions     Int       @default(0)
  criticalActions Int       @default(0)
  /// { [model]: { total, cited, mentioned, visibilityRate, citationRate } }
  perModel        Json?
  /// Top competitor domains in LLM answers: [{ domain, count, share }]
  competitors     Json?
  /// Detected anomalies vs. history: [{ type, metric, severity, previous, current, change, message }]
  anomalies       Json?
  /// Set once anomaly alerts were pushed, so a snapshot alerts at most once.
  alertedAt       DateTime?
  capturedAt      DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, kind, capturedAt])
  @@index([siteId, capturedAt])
}

/// One report / alert delivery attempt. kind: report | alert ; channel: email | webhook
/// status: sent | failed | simulated | skipped
model ReportDelivery {
  id         String   @id @default(cuid())
  siteId     String
  scheduleId String?
  kind       String   @default("report")
  channel    String
  target     String
  status     String
  subject    String?
  /// Report period key, e.g. "weekly:2026-11-02" — used to avoid sending the same period twice.
  periodKey  String?
  error      String?
  response   Json?
  createdAt  DateTime @default(now())

  site     Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  schedule ScheduledReport? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([scheduleId, createdAt])
}

/// Log of scheduled job executions. job: daily | weekly | reports | distribution | snapshot
/// trigger: cron | manual | api ; status: running | completed | partial | failed
model JobRun {
  id         String    @id @default(cuid())
  job        String
  trigger    String    @default("manual")
  status     String    @default("running")
  dryRun     Boolean   @default(false)
  summary    Json?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([job, startedAt])
}

/// Cross-process mutex: one row per job while it runs. Expired leases can be taken over.
model JobLock {
  job       String   @id
  runId     String
  expiresAt DateTime
}

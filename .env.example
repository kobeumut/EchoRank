# EchoRank: environment template.
#
# Copy this file to `.env` (git-ignored) and adjust the values. Never commit real secrets: every value below is a
# placeholder. Variables left empty are optional; the matching feature is then disabled or reports "not configured".
# Documentation: README.md (Configuration), SECURITY.md (deployment hardening).

# ---- API access ----
# If set, every /api/* route (except /api/health and /api/auth) requires the header
# `Authorization: Bearer <API_TOKEN>`, and the dashboard asks for the token on /login.
# Required for paid visibility checks (POST /api/sites/:id/visibility) and scheduled reports; other endpoints work without it.
# Use a long random value, for example: openssl rand -hex 32
# Always set it on an instance that is reachable from a network, and serve the app over HTTPS.
API_TOKEN=""
# Optional extra secret mixed into the signed dashboard session cookie (HMAC key = SESSION_SECRET + API_TOKEN).
# Set it (openssl rand -hex 32) so a weak API_TOKEN cannot be guessed offline from a leaked cookie.
# Changing API_TOKEN or SESSION_SECRET signs every dashboard user out.
SESSION_SECRET=""
# Key that encrypts per-site integration secrets (IndexNow key, Google service account JSON, webhook secrets) at rest
# with AES-256-GCM: 32 random bytes, base64 or hex. Generate with: openssl rand -base64 32
# Required when NODE_ENV=production (secrets are refused without it); development stores them unencrypted if empty.
# Keep it outside the database and its backups. Existing plaintext rows: npm run secrets:encrypt
SECRETS_ENCRYPTION_KEY=""
# Old keys (comma-separated), only used to decrypt during a rotation; see README (Configuration).
SECRETS_ENCRYPTION_KEY_PREVIOUS=""
# Failed-login counters for POST /api/auth: "database" (default; shared by all instances) or "memory" (per process).
LOGIN_RATE_LIMIT_STORE="database"

# ---- Database ----
# Development (SQLite; the path is relative to prisma/schema.prisma):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL). Also switch `provider` in prisma/schema.prisma and create a PostgreSQL baseline migration (see README):
# DATABASE_URL="postgresql://<user>:<password>@localhost:5432/echorank?schema=public"

# ---- LLM providers (visibility checks & content analysis) ----
# Two ways to reach a model, no code changes: API keys below, or the vendor's agent CLI (see LLM transport).
# For API access set an explicit model supported by your account and the provider's web-search tool.
# A provider with neither a key nor an installed CLI is reported as not_configured; no call is made for it.
# Visibility / assistant calls billed to an API key also require API_TOKEN; CLI-only runs do not. See docs/visibility.md.
OPENAI_API_KEY=""
OPENAI_MODEL=""
GEMINI_API_KEY=""
GEMINI_MODEL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL="sonar"

# ---- LLM transport: API keys OR local agent CLIs (no API key needed) ----
# auto (default): per model, the API when its key + model are set, otherwise the vendor's CLI if installed.
# api: keys only.  cli: CLIs only (API keys are ignored, so nothing is billed to a key).
# Mapping: chatgpt -> `codex`, claude -> `claude`, gemini -> `agy` (Antigravity). perplexity has no CLI.
# Each CLI must be signed in once, as the OS user that runs this server. CLI answers use your subscription quota.
LLM_TRANSPORT="auto"
# Only needed when the binary is not on the server's PATH (absolute path) / to pin a model (empty = the CLI's default).
# For AGY_CLI_MODEL pick a Gemini model (`agy models`) so the "Gemini" column really is Gemini.
CLAUDE_CLI_BIN=""
CLAUDE_CLI_MODEL=""
CODEX_CLI_BIN=""
CODEX_CLI_MODEL=""
AGY_CLI_BIN=""
AGY_CLI_MODEL=""
# Per-call limit in ms (1000-300000). One batch may make 2 x floor(400000 / timeout) CLI calls: 10 at the default.
LLM_CLI_TIMEOUT_MS=80000

# ---- Indexing / submission ----
# Per-site IndexNow keys are generated with POST /api/sites/:id/distribution/indexnow-key.
# INDEXNOW_KEY is a fallback for single-site deployments; the key file must be served at https://<your-site>/<INDEXNOW_KEY>.txt
INDEXNOW_KEY=""
INDEXNOW_ENDPOINT="https://api.indexnow.org/indexnow"
# Google Search Console / Indexing API service account, used when a site has no `googleServiceAccount` integration.
# Provide either the JSON content or the path to the key file (keep that file out of the repository).
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SERVICE_ACCOUNT_FILE=""
# Allow site URLs, the crawler / simulators, syndication webhooks and IndexNow checks to reach localhost and private networks.
# Development only: leave "false" in production (SSRF protection: every outbound request is then checked and connected to the
# validated public address, so DNS rebinding cannot reach internal hosts). Scheduled-report webhooks always require public addresses.
ALLOW_PRIVATE_NETWORK_TARGETS="false"

# ---- Crawler ----
# CRAWLER_MAX_PAGES: default page cap for audits whose site settings do not set `maxPages`.
CRAWLER_MAX_PAGES=500
# Reserved: the two settings below are not read by the current code (the Python crawler uses its own defaults and CLI flags).
CRAWLER_USER_AGENT="EchoRankBot/0.1 (+https://example.com/bot)"
CRAWLER_CONCURRENCY=4

# ---- GEO audit / scoring engine ----
# Path to the scoring CLI (services/crawler; Python 3.10+, `pip install -e services/crawler` gives `geo-audit`).
# When set, POST /api/sites/:id/audit runs it (with --progress: the dashboard shows an estimated percentage and
# can cancel it) and ingests the result; when empty, audits stay "queued" for an external worker that posts to
# /api/sites/:id/audit/:auditId/result, and the dashboard says nothing is executing them.
GEO_AUDIT_BIN=""
# Extra flags passed to geo-audit, split on whitespace, e.g. "--rps 2 --no-ua-probe".
GEO_AUDIT_ARGS=""
# Optional Crunchbase fallback for Wikidata entity reconciliation (read by the Python engine).
CRUNCHBASE_API_KEY=""

# ---- Scheduled reports ----
# E-mail delivery uses the Resend API and needs both values below (webhook delivery needs neither). See README (Scheduled reports).
RESEND_API_KEY=""
REPORT_FROM_EMAIL="reports@example.com"
# Reserved: SMTP settings are not read by the current code (reports are sent through Resend).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

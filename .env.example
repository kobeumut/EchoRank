# ---- Database ----
# Development (SQLite, file relative to prisma/schema.prisma):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — also switch `provider` in prisma/schema.prisma:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_visibility?schema=public"

# ---- LLM providers (visibility checks & content analysis) ----
# Set an explicit model supported by your account and the provider's web-search tool.
# Missing key/model is reported per provider; no calls are made for that provider.
# Visibility POST also requires API_TOKEN. See docs/visibility.md.
OPENAI_API_KEY=""
OPENAI_MODEL=""
GEMINI_API_KEY=""
GEMINI_MODEL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL="sonar"

# ---- Indexing / submission ----
# Per-site keys are generated via POST /api/sites/:id/distribution/indexnow-key.
# INDEXNOW_KEY is a fallback for single-site deployments; the key file must be served at
# https://<site>/<INDEXNOW_KEY>.txt
INDEXNOW_KEY=""
INDEXNOW_ENDPOINT="https://api.indexnow.org/indexnow"
# Google Search Console / Indexing API service account (fallback when a site has no
# `googleServiceAccount` integration). Either the JSON itself or a path to the key file.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SERVICE_ACCOUNT_FILE=""
# Allow webhooks / key-file checks to reach localhost and private networks (development only).
ALLOW_PRIVATE_NETWORK_TARGETS="false"

# ---- Crawler ----
CRAWLER_USER_AGENT="AIVisibilityBot/0.1 (+https://example.com/bot)"
CRAWLER_MAX_PAGES=500
CRAWLER_CONCURRENCY=4

# ---- GEO audit / scoring engine ----
# Path to the scoring CLI (services/crawler). When set, POST /api/sites/:id/audit runs it and ingests the result;
# when empty, audits stay "queued" for an external worker that posts to /api/sites/:id/audit/:auditId/result.
GEO_AUDIT_BIN=""
# Extra flags, e.g. "--rps 2 --no-ua-probe"
GEO_AUDIT_ARGS=""

# ---- Reports & notifications (see docs/scheduler-reports.md) ----
# auto: Resend -> SendGrid -> SMTP, whichever is configured; nothing configured = simulated (logged) delivery.
# Other values: smtp | resend | sendgrid | log
EMAIL_PROVIDER="auto"
REPORT_FROM_EMAIL="reports@example.com"
SMTP_HOST=""
SMTP_PORT=587
# Defaults to true for port 465.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""
# Public base URL of this app; adds "open report / download PDF" links to e-mails and chat messages.
APP_BASE_URL=""
# true = simulate every e-mail / webhook delivery and skip paid calls in scheduled jobs.
REPORTS_DRY_RUN="false"

# ---- Scheduler (`npm run scheduler`) ----
# Cron expressions (5 or 6 fields); "off" disables a job (e.g. when an external cron calls POST /api/jobs/run).
SCHEDULER_TIMEZONE="UTC"
CRON_DAILY="0 5 * * *"
CRON_WEEKLY="0 2 * * 1"
CRON_REPORTS="*/15 * * * *"
CRON_DISTRIBUTION="*/10 * * * *"
CRON_SNAPSHOT="off"

# ---- API ----
# If set, /api/* requires header `Authorization: Bearer <API_TOKEN>`.
# Required for paid POST /api/sites/:id/visibility; other endpoints remain optional.
API_TOKEN=""

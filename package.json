{
  "name": "ai-visibility",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted GEO & SEO platform: track how AI answer engines cite your site, score AI-crawler readiness and E-E-A-T, build an entity knowledge graph and distribute updates to search indexes.",
  "keywords": [
    "geo",
    "generative-engine-optimization",
    "seo",
    "ai-visibility",
    "llm",
    "knowledge-graph",
    "llms-txt",
    "indexnow",
    "schema-org",
    "nextjs"
  ],
  "homepage": "https://github.com/kobeumut/ai-visibility#readme",
  "bugs": {
    "url": "https://github.com/kobeumut/ai-visibility/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobeumut/ai-visibility.git"
  },
  "author": "Umut ADALI <kobeumut@gmail.com>",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "reports:worker": "node --env-file-if-exists=.env --import tsx scripts/report-worker.ts",
    "reports:run": "node --env-file-if-exists=.env --import tsx scripts/report-worker.ts --once",
    "reports:sample": "node --env-file-if-exists=.env --import tsx scripts/report-sample.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "d3-force": "^3.0.1",
    "next": "16.4.5",
    "node-cron": "^4.6.0",
    "pdfmake": "^0.3.14",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

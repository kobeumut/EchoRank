# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ---- Environment and secrets (never commit real values; .env.example is the template) ----
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
# Google service-account / credential files
*service-account*.json
credentials*.json

# ---- Node.js dependencies ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js / build output ----
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo
.vercel

# ---- Testing and coverage ----
/coverage
/.nyc_output
.coverage
htmlcov/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Local databases (SQLite dev and test databases) ----
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
*.sqlite
*.sqlite3

# ---- Python (services/crawler) ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
/services/crawler/build/
/services/crawler/dist/
# Local crawl / audit output written next to the CLIs (graph.json, audit.json, rows.json, ...)
/services/crawler/*.json
/services/crawler/*.graphml

# ---- Local audit and report output ----
/artifacts/
/audit-output/
/crawl-output/
/report-output/

# ---- Editors and OS files ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Local AI-assistant / agent tooling ----
.multica/
.claude/settings.local.json
